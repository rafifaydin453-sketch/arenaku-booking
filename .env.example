# =========================================================
# ArenaKu - CATATAN
# =========================================================
# Aplikasi ArenaKu TIDAK membaca file .env.
# File ini hanya template referensi agar struktur repository rapi.
#
# Konfigurasi yang benar-benar dipakai:
#   config/koneksi.local.php       (opsional, salin dari koneksi.local.example.php)
#   config/midtrans_keys.php       (salin dari midtrans_keys.example.php)
#   config/environment.php         (opsional, salin dari environment.example.php)
#
# Jangan menaruh key/password asli di file ini.
# =========================================================

# Referensi koneksi database (tidak dibaca otomatis)
DB_HOST=localhost
DB_NAME=arenaku
DB_USER=root
DB_PASS=

# Referensi Midtrans (tidak dibaca otomatis)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
